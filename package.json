{
  "name": "luminary",
  "version": "0.1.0",
  "private": true,
  "description": "「流光」— 基金 & 贵金属实时监控平台",
  "scripts": {
    "dev": "pnpm -F @fund-monitor/app dev",
    "dev:bff": "cd packages/bff && node --import tsx src/dev.ts",
    "dev:all": "concurrently \"pnpm dev:bff\" \"pnpm dev\"",
    "build": "pnpm -F @fund-monitor/shared build && pnpm -F @fund-monitor/data-service build && pnpm -F @fund-monitor/app build",
    "deploy:bff": "pnpm -F @fund-monitor/bff deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "msw"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.1"
  }
}
